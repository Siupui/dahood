                        d.tracer.To = Vector2.new(pos.X, pos.Y)
                        d.tracer.Visible = CFG.ESPTracers
                        if CFG.ESPDistance then
                            d.dist.Text = math.floor((root.Position-Camera.CFrame.Position).Magnitude) .. "m"
                            d.dist.Position = Vector2.new(pos.X, pos.Y + h/2 + 4)
                            d.dist.Visible = true
                        else
                            d.dist.Visible = false
                        end
                        
                        for _, bone in ipairs(d.skeleton) do
                            local fromPart = plr.Character:FindFirstChild(bone.from)
                            local toPart = plr.Character:FindFirstChild(bone.to)
                            if fromPart and toPart then
                                local fromPos, fromOn = Camera:WorldToViewportPoint(fromPart.Position)
                                local toPos, toOn = Camera:WorldToViewportPoint(toPart.Position)
                                if fromOn and toOn then
                                    bone.line.From = Vector2.new(fromPos.X, fromPos.Y)
                                    bone.line.To = Vector2.new(toPos.X, toPos.Y)
