-- INPUT HANDLING
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if isKeyMatch(input, CFG.AimbotKey) then
        if CFG.AimbotMode == "hold" then locked = true
        elseif CFG.AimbotMode == "toggle" then locked = not locked end
    end
    if isKeyMatch(input, CFG.StickyAimKey) then
        if stickyTarget then
            stickyTarget = nil
            notify("Sticky", "Unlocked", 1.5)
        else
            local t = getClosest(CFG.AimPart)
            if t then
                stickyTarget = t
                locked = true
                notify("Sticky", "Locked: " .. t.Name, 1.5)
            end
        end
    end
    if isKeyMatch(input, CFG.OrbitKey) then
        orbiting = not orbiting
        if orbiting then
            local t = stickyTarget or getClosest(CFG.AimPart)
            if t then
                stickyTarget = t
                notify("Orbit", "Orbiting: " .. t.Name, 1.5)
            else
                orbiting = false
                notify("Orbit", "No target", 1.5)
            end
        else
            notify("Orbit", "Stopped", 1.5)
        end
    end
    if isKeyMatch(input, CFG.SilentAimKey) then
        if CFG.SilentAimMode == "hold" then silentLocked = true
        elseif CFG.SilentAimMode == "toggle" then silentLocked = not silentLocked end
    end
    if isKeyMatch(input, CFG.FlingKey) then CFG.FlingEnabled = true end
    if isKeyMatch(input, CFG.TeleportKey) and CFG.TeleportToMouse then
        local lr = getRoot(LocalPlayer.Character)
        if lr then
            local ray = Camera:ScreenPointToRay(Mouse.X, Mouse.Y)
            local hit = Workspace:FindPartOnRay(Ray.new(ray.Origin, ray.Direction * 500), LocalPlayer.Character)
            if hit then lr.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0)); notify("Teleport", "Teleported", 1.5) end
        end
    end
end)

