-- FLY FUNCTION
toggleFly = function(state)
    flying = state
    local root = getRoot(LocalPlayer.Character)
    if not root then return end
    if flying then
        pcall(function()
            linVel = Instance.new("LinearVelocity")
            linVel.MaxForce = 9e9
            linVel.Attachment0 = root:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", root)
            linVel.Parent = root
        end)
        pcall(function()
            alignOri = Instance.new("AlignOrientation")
            alignOri.MaxTorque = 9e9
            alignOri.Attachment0 = root:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", root)
            alignOri.Parent = root
        end)
        if not linVel then
            bodyVel = Instance.new("BodyVelocity")
            bodyVel.MaxForce = Vector3.new(9e9,9e9,9e9)
            bodyVel.Parent = root
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(9e9,9e9,9e9)
            bodyGyro.P = 9e4
            bodyGyro.Parent = root
        end
        RunService:BindToRenderStep("CinderFly", Enum.RenderPriority.Camera.Value, function()
            if not flying then return end
            local cam = Camera.CFrame
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
            if linVel then
                linVel.VectorVelocity = dir.Magnitude > 0 and dir.Unit * CFG.FlySpeed or Vector3.zero
                if alignOri then alignOri.CFrame = cam end
            else
                bodyVel.Velocity = dir.Magnitude > 0 and dir.Unit * CFG.FlySpeed or Vector3.zero
                bodyGyro.CFrame = cam
            end
        end)
    else
        RunService:UnbindFromRenderStep("CinderFly")
        if linVel then linVel:Destroy() linVel = nil end
        if alignOri then alignOri:Destroy() alignOri = nil end
        if bodyVel then bodyVel:Destroy() bodyVel = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    end
end

