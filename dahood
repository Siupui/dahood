                                else
                                    bone.line.Visible = false
                                end
                            else
                                bone.line.Visible = false
                            end
                        end
                    end)
                else
                    pcall(function()
                        d.box.Visible = false
                        d.name.Visible = false
                        d.health.Visible = false
                        d.tracer.Visible = false
                        d.dist.Visible = false
                        for _, bone in ipairs(d.skeleton) do bone.line.Visible = false end
                    end)
