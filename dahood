local function loadConfig()
    pcall(function()
        if safeIsFile("KafexLua_config.json") then
            local decoded = HttpService:JSONDecode(safeReadFile("KafexLua_config.json"))
            for k, v in pairs(decoded) do if CFG[k] ~= nil then CFG[k] = v end end
            notify("Config", "Loaded successfully", 2)
        end
    end)
end
