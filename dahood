                        dCorner.CornerRadius = UDim.new(1, 0)
                        dCorner.Parent = dot
                        table.insert(radarDots, dot)
                    end
                end
            end
        end
    end
    
    -- Sticky / normal aimbot
    if CFG.AimbotEnabled and (locked or stickyTarget) then
        local aimTarget = stickyTarget
        if not aimTarget or not isAlive(aimTarget) then
            aimTarget = getClosest(CFG.AimPart)
            if CFG.StickyAim and locked and aimTarget then
                stickyTarget = aimTarget
            end
        end
        if aimTarget and isAlive(aimTarget) then
            target = aimTarget
            local pred = getPredictedPos(aimTarget, CFG.AimPart, CFG.Prediction)
            if pred then
                local camPos = Camera.CFrame.Position
                local newCF = CFrame.new(camPos, pred)
                -- Sticky = hard lock (crosshair always on head), otherwise smooth
                if CFG.StickyAim or stickyTarget then
                    Camera.CFrame = newCF
                elseif CFG.AimSmooth and CFG.AimSmooth > 0 and CFG.AimSmooth < 1 then
                    Camera.CFrame = Camera.CFrame:Lerp(newCF, CFG.AimSmooth)
                else
                    Camera.CFrame = newCF
                end
            end
        else
            stickyTarget = nil
        end
    end
end)

-- SILENT AIM HOOK (Da Hood / Universal / HvH)
local function getSilentTarget()
    if stickyTarget and isAlive(stickyTarget) then return stickyTarget end
    if CFG.UseAimbotTarget and target and isAlive(target) then return target end
    return getClosest(CFG.SilentPart)
end

pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if CFG.SilentAim and (silentLocked or CFG.SilentAlways) and method == "FireServer" then
            local remoteName = tostring(self)
            local arg1 = tostring(args[1] or "")
            local isMouseRemote = (
                arg1 == "MousePos" or arg1 == "MouseUpdatedPos" or arg1 == "UpdateMousePos" or
                arg1 == "MOUSE" or arg1 == "Shoot" or arg1 == "UpdateMouse" or
                arg1:lower():find("mouse") or arg1:lower():find("pos")
            )
            if isMouseRemote or remoteName:find("MainEvent") or remoteName:find("RemoteEvent") then
                local t = getSilentTarget()
                if t and isAlive(t) then
                    local predAmt = CFG.Prediction or 0.12
                    if CFG.EnablePrediction == false then predAmt = 0 end
                    local partName = CFG.SilentPart or "Head"
                    if CFG.ClosestPart then
                        -- pick closest part to camera
                        local best, bestDist = nil, math.huge
                        for _, pname in ipairs({"Head","UpperTorso","HumanoidRootPart","LowerTorso"}) do
                            local p = getPart(t.Character, pname)
                            if p then
                                local sp, on = Camera:WorldToViewportPoint(p.Position)
                                if on then
                                    local d = (Vector2.new(sp.X,sp.Y) - Vector2.new(Mouse.X,Mouse.Y)).Magnitude
                                    if d < bestDist then bestDist = d; best = pname end
                                end
                            end
                        end
                        if best then partName = best end
                    end
                    local pos = getPredictedPos(t, partName, predAmt)
                    if pos then
                        args[2] = pos
                        return old(self, unpack(args))
                    end
                end
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

-- Mouse.Hit / Mouse.Target override (works on many executors)
pcall(function()
    local mt = getrawmetatable(Mouse)
    if not mt then return end
    local oldIndex = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, key)
        if CFG.SilentAim and (silentLocked or CFG.SilentAlways) then
            if key == "Hit" or key == "hit" then
                local t = getSilentTarget()
                if t and isAlive(t) then
                    local predAmt = CFG.Prediction or 0.12
                    if CFG.EnablePrediction == false then predAmt = 0 end
                    local pos = getPredictedPos(t, CFG.SilentPart or "Head", predAmt)
                    if pos then
                        return CFrame.new(pos)
                    end
                end
            elseif key == "Target" or key == "target" then
                local t = getSilentTarget()
                if t and isAlive(t) then
                    return getPart(t.Character, CFG.SilentPart or "Head") or getRoot(t.Character)
                end
            end
        end
        return oldIndex(self, key)
    end)
    setreadonly(mt, true)
end)

-- HEARTBEAT LOOP
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local root = getRoot(char)
    if not hum or not root then return end
    
    -- ORBIT (HvH) - stick to target and circle while aiming
    if (orbiting or CFG.OrbitEnabled) and stickyTarget and isAlive(stickyTarget) then
        local tRoot = getRoot(stickyTarget.Character)
        if tRoot then
            orbitAngle = orbitAngle + (CFG.OrbitSpeed * 0.06)
            local dist = CFG.OrbitDistance
            local height = CFG.OrbitHeight
            local offset = Vector3.new(
                math.cos(orbitAngle) * dist,
                height,
                math.sin(orbitAngle) * dist
            )
            -- Smooth stick
            local targetCF = CFrame.new(tRoot.Position + offset)
            root.CFrame = root.CFrame:Lerp(targetCF, 0.45)
            -- Force camera + character look at target head
            local lookPos = getPredictedPos(stickyTarget, CFG.SilentPart or "Head", CFG.Prediction) or tRoot.Position
            if lookPos then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, lookPos)
                if root then
                    root.CFrame = CFrame.new(root.Position, Vector3.new(lookPos.X, root.Position.Y, lookPos.Z))
                end
            end
        end
    elseif orbiting and (not stickyTarget or not isAlive(stickyTarget)) then
        orbiting = false
        stickyTarget = nil
    end
    
    if CFG.SpeedEnabled then hum.WalkSpeed = CFG.WalkSpeed else hum.WalkSpeed = 16 end
    hum.JumpPower = CFG.JumpPower
    
    if CFG.Noclip then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    
    if CFG.GodMode and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    
    if CFG.AntiRagdoll and hum:GetState() == Enum.HumanoidStateType.Physics then
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    
    if CFG.AntiVoid and root.Position.Y < -50 then
        root.CFrame = CFrame.new(0, 100, 0)
    end
    
    if CFG.FlingEnabled then
        local t = target or getClosest()
        if t and isAlive(t) then
            local er = getRoot(t.Character)
            if er then
                root.CFrame = er.CFrame
                local bv = Instance.new("BodyVelocity")
                bv.Velocity = Vector3.new(1,1,1) * CFG.FlingPower
                bv.MaxForce = Vector3.new(9e9,9e9,9e9)
                bv.Parent = er
                Debris:AddItem(bv, 0.08)
            end
        end
    end
    
    if CFG.HitboxExpander then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isAlive(plr) then
                local r = getRoot(plr.Character)
                if r then
                    r.Size = Vector3.new(CFG.HitboxSize, CFG.HitboxSize, CFG.HitboxSize)
                    r.Transparency = 0.7
                    r.CanCollide = false
                end
            end
        end
    end
    
    if CFG.Triggerbot and (target or getClosest()) then
        pcall(function() mouse1click() end)
        task.wait(CFG.TriggerDelay)
    end
    
    if CFG.Killaura then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isAlive(plr) then
                local r = getRoot(plr.Character)
                if r and (r.Position - root.Position).Magnitude <= CFG.KillauraRange then
                    pcall(function()
                        local ev = LocalPlayer.Backpack:FindFirstChild("MainEvent") or LocalPlayer.Character:FindFirstChild("MainEvent")
                        if ev then ev:FireServer("Shoot", r.Position) end
                    end)
                end
            end
        end
    end
    
    if CFG.AutoParry then
        pcall(function()
            local ev = LocalPlayer.Backpack:FindFirstChild("MainEvent") or LocalPlayer.Character:FindFirstChild("MainEvent")
            if ev then ev:FireServer("Parry") end
        end)
    end
end)

-- ESP SYSTEM
local function createESP(plr)
    espDrawings[plr] = {
        box = Drawing.new("Square"),
        name = Drawing.new("Text"),
        health = Drawing.new("Line"),
        tracer = Drawing.new("Line"),
        dist = Drawing.new("Text"),
        skeleton = {}
    }
    local d = espDrawings[plr]
    d.box.Thickness = 1
    d.box.Filled = false
    d.box.Color = getESPColor()
    d.name.Size = 13
    d.name.Center = true
    d.name.Outline = true
    d.name.Color = Color3.new(1,1,1)
    d.health.Thickness = 2
    d.tracer.Thickness = 1
    d.tracer.Color = getESPColor()
    d.dist.Size = 11
    d.dist.Center = true
    d.dist.Outline = true
    d.dist.Color = Color3.fromRGB(200,200,210)
    
    local boneNames = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"UpperTorso", "RightUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LowerTorso", "RightUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"}
    }
    for _, pair in ipairs(boneNames) do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Color = getESPColor()
        line.Visible = false
        table.insert(d.skeleton, {line = line, from = pair[1], to = pair[2]})
    end
end

