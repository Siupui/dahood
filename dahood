                        d.health.From = Vector2.new(pos.X - w/2 - 4, pos.Y + h/2)
                        d.health.To = Vector2.new(pos.X - w/2 - 4, pos.Y + h/2 - h*hp)
                        d.health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                        d.health.Visible = CFG.ESPHealth
