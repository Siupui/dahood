local function getKeybindName(keybind)
    if not keybind then return "None" end
    if keybind.Type == "Key" then return keybind.Value end
    if keybind.Type == "MouseButton" then
        return ({MouseButton1 = "LMB", MouseButton2 = "RMB", MouseButton3 = "MMB"})[keybind.Value] or keybind.Value
    end
    return "None"
end

local function isKeyMatch(input, keybind)
    if not keybind then return false end
    if keybind.Type == "Key" then return input.KeyCode == Enum.KeyCode[keybind.Value] end
    if keybind.Type == "MouseButton" then return input.UserInputType == Enum.UserInputType[keybind.Value] end
    return false
end

local function isAlive(plr)
    return plr and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0
end

local function getRoot(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function getPart(char, name)
    return char and char:FindFirstChild(name)
end

local function wallCheck(from, to)
    if not CFG.WallCheck then return true end
    local ray = Ray.new(from, (to - from).Unit * (to - from).Magnitude)
    local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Camera})
    return hit == nil
end

local function getClosest(partName)
    partName = partName or CFG.AimPart
    local closest, dist = nil, CFG.AimFOV
    local myRoot = getRoot(LocalPlayer.Character)
    if not myRoot then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) then
            if CFG.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
                -- skip
            else
                local part = getPart(plr.Character, partName) or getRoot(plr.Character)
                if part then
                    local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local delta = (Vector2.new(screen.X, screen.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                        if delta < dist and wallCheck(Camera.CFrame.Position, part.Position) then
                            dist = delta
                            closest = plr
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function getPredictedPos(plr, partName, predAmount)
    partName = partName or CFG.AimPart
    predAmount = predAmount or CFG.Prediction
    local part = getPart(plr.Character, partName) or getRoot(plr.Character)
    if not part then return nil end
    local pos = part.Position
    local root = getRoot(plr.Character)
    if root and predAmount and predAmount > 0 then
        local vel = root.Velocity
        pos = pos + Vector3.new(vel.X * predAmount, vel.Y * predAmount, vel.Z * predAmount)
    end
    return pos
end

